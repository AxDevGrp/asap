# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Resend
RESEND_API_KEY=re_xxxx
RESEND_WEBHOOK_SECRET=whsec_xxxx

# AI — all model calls go through OpenRouter (one key, any model)
# Get key at: https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-xxxx
# Optional overrides (defaults shown)
# AI_BASE_URL=https://openrouter.ai/api/v1
# AI_CHAT_MODEL=google/gemma-4-26b-a4b-it
# AI_EMBEDDING_MODEL=google/gemini-embedding-2

# Decisions (typed JEV with LLM fallback) — server-only
# DECISION_MODEL=~typesafe/jev-latest
# DECISION_ENGINE=jev   # jev (default) | llm (force the LLM fallback)

# App
APP_URL=https://goasap.ai

# Background jobs — shared secret for POST /api/jobs/run (Bearer token).
# Required in production; a scheduler must call the runner every minute.
JOBS_SECRET=change-me-to-a-long-random-string
