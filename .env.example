# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Resend
RESEND_API_KEY=re_xxxx
RESEND_WEBHOOK_SECRET=whsec_xxxx

# AI Triage — Google AI Studio free tier (Gemma 4 26B MoE)
# Get key at: https://aistudio.google.com
GOOGLE_API_KEY=AIza_xxxx

# App
APP_URL=https://goasap.ai

# Background jobs — shared secret for POST /api/jobs/run (Bearer token).
# Required in production; a scheduler must call the runner every minute.
JOBS_SECRET=change-me-to-a-long-random-string
